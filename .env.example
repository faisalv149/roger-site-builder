# Google Maps Platform key with "Places API (New)" enabled (also used for PageSpeed Insights if enabled)
GOOGLE_MAPS_API_KEY=
# Optional separate key for PageSpeed Insights API (falls back to GOOGLE_MAPS_API_KEY)
PAGESPEED_API_KEY=
# Claude API key. Without it the builder uses deterministic template fallbacks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Local demos without an API key: 1 = use the signed-in Claude Code CLI (`claude -p`) instead. An API key above wins.
CLAUDE_CLI=
# Optional: path to the claude executable if it isn't on PATH
CLAUDE_CLI_PATH=
# Public URL where this server is reachable (used for og:image / iMessage rich links and lead form posts)
PUBLIC_BASE_URL=http://localhost:4000
PORT=4000
# Force mock data (fixtures) even if a Google key is set: 1 = on
MOCK=
# Optional: POST every new lead (quote form submission) to this URL as JSON
LEAD_WEBHOOK_URL=
# Optional: Chromium path for site screenshots (OG preview image). Auto-detected from Playwright if unset.
CHROMIUM_PATH=
# Optional: your iMessage gateway's send endpoint. Messages Roger sends later (the preview after "On it") are POSTed here as { from, replies }
IMESSAGE_OUTBOUND_URL=
