  "reviews": [
    {
      "author": "Maria Gonzalez",
      "rating": 5,
      "relativeTime": "2 weeks ago",
      "text": "After the hail storm in March we had three leaks. Summit Peak came out the next morning, tarped the roof and handled the whole insurance claim. The new roof looks fantastic and the crew cleaned up every nail."
    },
    {
      "author": "James Whitfield",
      "rating": 5,
      "relativeTime": "a month ago",
      "text": "Honest inspection, no upsell. They found a flashing problem around our chimney that two other companies missed and fixed it for a fair price."
    },
    {
      "author": "Priya Natarajan",
      "rating": 5,
      "relativeTime": "2 months ago",
      "text": "Full roof replacement with architectural shingles. On time, on budget, and they explained the warranty clearly. Highly recommend for anyone in South Austin."
    },
    {
      "author": "Tom Becker",
      "rating": 4,
      "relativeTime": "3 months ago",
      "text": "Good work replacing our gutters and repairing storm damage. Scheduling took a few days longer than hoped but the quality is great."
    },
    {
      "author": "Leah Kim",
      "rating": 5,
      "relativeTime": "5 months ago",
      "text": "Quick leak repair before a big rain. Friendly, licensed and insured, and they sent photos of everything they fixed."
    }
  ],
