{
  "meta": {
    "name": "Plumbing \u00b7 Local and Trusted",
    "vertical": "plumbing",
    "variant": "trust",
    "description": "Reputation first: narrow centered 8-column grid, rounded cards, reviews before services.",
    "schemaVersion": 2,
    "previewImage": "/themes/plumbing-trust.png"
  },
  "match": {
    "googleTypes": [
      "plumber"
    ]
  },
  "fontPairs": [
    {
      "id": "sturdy",
      "label": "Classic serif",
      "heading": "Georgia, 'Times New Roman', serif",
      "body": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    },
    {
      "id": "modern",
      "label": "Clean modern",
      "heading": "'Segoe UI', 'Helvetica Neue', Arial, sans-serif",
      "body": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    },
    {
      "id": "friendly",
      "label": "Rounded friendly",
      "heading": "ui-rounded, 'SF Pro Rounded', 'Arial Rounded MT Bold', 'Trebuchet MS', sans-serif",
      "body": "'Trebuchet MS', 'Segoe UI', Tahoma, sans-serif"
    }
  ],
  "defaultPair": "friendly",
  "fontFaces": [],
  "type": {
    "scale": {
      "xs": 13,
      "sm": 15,
      "md": 17,
      "lg": 20,
      "xl": 26,
      "2xl": 34,
      "3xl": 44,
      "4xl": {
        "phone": 40,
        "desktop": 60
      }
    },
    "measure": 65,
    "bodyWeight": 400,
    "headingWeight": 700,
    "headingCase": "none",
    "headingTracking": "0",
    "lineHeight": {
      "heading": 1.2,
      "body": 1.6
    }
  },
  "palette": {
    "brand": "#B45309",
    "ink": "#14202B",
    "inkMuted": "#4A5968",
    "surface": "#FFFFFF",
    "surfaceAlt": "#F6F2EA"
  },
  "derive": {
    "space": "oklch",
    "tints": [
      97,
      94,
      90
    ],
    "shades": [
      45,
      35,
      25
    ],
    "brandInkAuto": true,
    "minButtonContrast": 4.5
  },
  "overlayAlpha": 0.55,
  "overlayStyle": "gradient-bottom",
  "brandColor": {
    "source": [
      "logo",
      "website",
      "default"
    ],
    "rejectNearGray": true,
    "rejectNeon": true,
    "minChroma": 0.04,
    "maxChroma": 0.3,
    "darkenUntilContrast": true
  },
  "logo": {
    "placement": "header-left",
    "maxHeight": {
      "phone": 36,
      "desktop": 48
    },
    "band": "surface",
    "padding": 8,
    "fallback": "wordmark",
    "wordmark": {
      "font": "heading",
      "case": "title",
      "maxLines": 2,
      "color": "brand"
    }
  },
  "grid": {
    "system": "centered-8",
    "columns": 8,
    "maxWidth": 960,
    "gutter": 20,
    "margin": {
      "phone": 20,
      "desktop": 40
    }
  },
  "spacing": {
    "scale": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64
    ],
    "sectionY": {
      "phone": 48,
      "desktop": 88
    },
    "density": "comfortable"
  },
  "radius": {
    "sm": 8,
    "md": 16,
    "lg": 24
  },
  "shadow": {
    "card": "0 4px 16px rgba(0,0,0,0.08)"
  },
  "buttons": {
    "primary": {
      "fill": "brand",
      "ink": "brand-ink",
      "border": "none",
      "radius": "lg",
      "height": 48,
      "case": "none",
      "weight": 700
    },
    "secondary": {
      "fill": "transparent",
      "ink": "brand",
      "border": "brand",
      "radius": "lg",
      "height": 48,
      "case": "none",
      "weight": 700
    },
    "minTapTarget": 44,
    "focusRing": "2px solid shade-1"
  },
  "icons": {
    "set": "lucide",
    "stroke": 1.75,
    "size": 24,
    "color": "brand",
    "style": "outline"
  },
  "images": {
    "hero": {
      "ratio": {
        "phone": "4:5",
        "desktop": "16:9"
      },
      "fit": "cover"
    },
    "gallery": {
      "ratio": "4:3",
      "fit": "cover"
    },
    "minWidth": 800,
    "minHeight": 600,
    "maxGallery": 9,
    "rejectTextHeavy": true,
    "maxFileKb": 250
  },
  "motion": "subtle",
  "colorScheme": "light",
  "sections": [
    "hero",
    "proof",
    "gallery",
    "services",
    "area",
    "quote",
    "footer"
  ],
  "sectionLayout": {
    "hero": {
      "variant": "stacked",
      "imagePosition": "below",
      "imageInset": true,
      "align": "center"
    },
    "proof": {
      "variant": "review-cards",
      "columns": {
        "phone": 1,
        "desktop": 2
      }
    },
    "gallery": {
      "variant": "carousel",
      "perView": {
        "phone": 1.2,
        "desktop": 2.5
      }
    },
    "services": {
      "variant": "card-list",
      "columns": {
        "phone": 1,
        "desktop": 2
      }
    },
    "area": {
      "variant": "card",
      "span": {
        "desktop": 8
      }
    },
    "quote": {
      "variant": "inset-card",
      "span": {
        "desktop": 6,
        "offset": 1
      }
    },
    "footer": {
      "variant": "centered-stack",
      "columns": {
        "phone": 1,
        "desktop": 1
      }
    }
  },
  "sectionRules": {
    "services": {
      "min": 3,
      "max": 6,
      "overflowLink": "Ask about other services"
    },
    "proof": {
      "minRating": 4.0,
      "minReviews": 5,
      "showQuotes": true,
      "maxQuotes": 2,
      "maxQuoteChars": 160
    },
    "gallery": {
      "minPhotos": 3
    },
    "area": {
      "showMap": true,
      "maxPlaces": 8
    },
    "hours": {
      "showOpenNow": true,
      "format": "week"
    }
  },
  "copy": {
    "hero": "Plumbers you can call in {city}",
    "subline": "Repairs, drains and water heaters for homes in {city}. Tell us what you need.",
    "urgent": "Burst pipe or no hot water? Call us now.",
    "action": "Call a plumber",
    "actionKind": "form",
    "quoteTitle": "Tell us what's wrong",
    "sublineNoServices": "Repairs, drains and water heaters for homes in {city}.",
    "heroNoCity": "Plumbers you can call"
  },
  "placeholders": [
    "{business}",
    "{city}",
    "{state}",
    "{zip}",
    "{rating}",
    "{reviewCount}",
    "{years}"
  ],
  "services": {
    "defaults": [
      {
        "id": "leak",
        "label": "Leak repair",
        "icon": "droplet",
        "keywords": [
          "leak",
          "pipe"
        ]
      },
      {
        "id": "drain",
        "label": "Drain cleaning",
        "icon": "rotate-cw",
        "keywords": [
          "drain",
          "clog",
          "sewer"
        ]
      },
      {
        "id": "water-heater",
        "label": "Water heaters",
        "icon": "thermometer",
        "keywords": [
          "water heater",
          "tankless"
        ]
      },
      {
        "id": "fixtures",
        "label": "Faucets and fixtures",
        "icon": "tool",
        "keywords": [
          "faucet",
          "toilet",
          "fixture"
        ]
      },
      {
        "id": "sewer",
        "label": "Sewer line repair",
        "icon": "git-branch",
        "keywords": [
          "sewer",
          "main line"
        ]
      },
      {
        "id": "repipe",
        "label": "Repiping",
        "icon": "shuffle",
        "keywords": [
          "repipe",
          "copper",
          "pex"
        ]
      },
      {
        "id": "gas",
        "label": "Gas lines",
        "icon": "flame",
        "keywords": [
          "gas line"
        ]
      },
      {
        "id": "sump",
        "label": "Sump pumps",
        "icon": "arrow-down-circle",
        "keywords": [
          "sump"
        ]
      },
      {
        "id": "emergency",
        "label": "24/7 emergency plumbing",
        "icon": "phone",
        "keywords": [
          "emergency",
          "24"
        ]
      }
    ]
  },
  "trust": {
    "max": 4,
    "templates": {
      "licensed": "Licensed in {state}",
      "insured": "Fully insured",
      "years": "{years} years serving {city}",
      "warranty": "Workmanship warranty"
    }
  },
  "roger": {
    "stickyBar": true,
    "headerCallButton": true,
    "chatBubble": true,
    "textPrefill": "Hi, I have a plumbing problem.",
    "consentCopy": "By submitting, you agree to receive calls and texts about your request.",
    "previewBanner": true,
    "footerCredit": true
  },
  "seo": {
    "titlePattern": "{business} | Plumbing in {city}, {state}",
    "descriptionPattern": "{business} is a licensed plumber in {city} for repairs, drain cleaning and water heaters. Call now or request service.",
    "schemaType": "Plumber",
    "ogImage": "hero"
  },
  "locale": "en-US",
  "stock": {
    "hero": [
      {
        "url": "/stock/plumbing-hero.svg",
        "width": 1920,
        "height": 1080,
        "alt": "Placeholder stock photo: plumbing crew",
        "source": "stock"
      }
    ],
    "gallery": [
      {
        "url": "/stock/plumbing-1.svg",
        "width": 1200,
        "height": 900,
        "alt": "Placeholder stock photo: plumbing work 1",
        "source": "stock"
      },
      {
        "url": "/stock/plumbing-2.svg",
        "width": 1200,
        "height": 900,
        "alt": "Placeholder stock photo: plumbing work 2",
        "source": "stock"
      },
      {
        "url": "/stock/plumbing-3.svg",
        "width": 1200,
        "height": 900,
        "alt": "Placeholder stock photo: plumbing work 3",
        "source": "stock"
      }
    ]
  }
}